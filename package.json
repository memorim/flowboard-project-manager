{
  "name": "flowboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "node --test --import tsx tests/*.test.ts tests/demo.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "build:demo": "tsc -b && vite build --mode demo",
    "test:e2e": "playwright test",
    "measure": "node --import tsx scripts/measure.ts",
    "measure:scale": "node --import tsx scripts/scale.ts",
    "backup": "node --import tsx server/backup.ts",
    "test:upgrade": "node tests/check-upgrade.mjs",
    "backup:status": "node --import tsx server/backup-status.ts",
    "test:contract": "node --import tsx tests/check-contract.mjs",
    "account:create": "tsx --env-file-if-exists=.account.env server/create-account.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.7.0"
  }
}
