{
  "name": "flowboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "node --test --import tsx tests/*.test.ts tests/demo.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "build:demo": "tsc -b && vite build --mode demo",
    "test:e2e": "playwright test",
    "measure": "node --import tsx scripts/measure.ts",
    "measure:scale": "node --import tsx scripts/scale.ts",
    "backup": "node --import tsx server/backup.ts",
    "test:upgrade": "node tests/check-upgrade.mjs",
    "backup:status": "node --import tsx server/backup-status.ts",
    "test:contract": "node --import tsx tests/check-contract.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.7.0"
  }
}
