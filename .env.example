# Optional local API port; default used by pnpm start.
PORT=4100
HOST=127.0.0.1
# Default: verified server sessions. Demo identity is opt-in and rejected in production/non-loopback configurations.
FLOW_AUTH_MODE=session
# Required HTTPS origin with NODE_ENV=production, e.g. https://flowboard.example.com
FLOW_PUBLIC_ORIGIN=
FLOW_COOKIE_SECURE=false
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=data/backups
# Optional owner-configured HTTPS alert destination.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_TOKEN=
