# Single-server defaults. Use the full local stack with pnpm setup:local + docker compose up --build -d.
HOST=127.0.0.1
PORT=4100
FLOW_AUTH_MODE=session
FLOW_PUBLIC_ORIGIN=http://127.0.0.1:4100
FLOW_COOKIE_SECURE=false
# Optional: use PostgreSQL instead of the existing data/flowboard.db.
DATABASE_URL=
FLOW_POSTGRES_SCHEMA=flowboard
# 32 random bytes in base64. Required for MFA and the encrypted mail queue. Keep across restarts/backups.
FLOW_APP_KEY=
FLOW_REGISTRATION_ENABLED=true
# Optional social sign-in. Register an application with each selected provider.
# Callback: FLOW_PUBLIC_ORIGIN/api/auth/oauth/{google|yandex|github}/callback
FLOW_GOOGLE_CLIENT_ID=
FLOW_GOOGLE_CLIENT_SECRET=
FLOW_YANDEX_CLIENT_ID=
FLOW_YANDEX_CLIENT_SECRET=
FLOW_GITHUB_CLIENT_ID=
FLOW_GITHUB_CLIENT_SECRET=
# Trust only a known proxy topology. Leave empty for direct access. Allowed values: 1..3.
FLOW_TRUST_PROXY_HOPS=
FLOW_WRITES_PER_MINUTE=120
FLOW_WORKSPACE_QUOTA=100
FLOW_PROJECT_QUOTA=500
FLOW_INVITATION_QUOTA=200
# SMTP: TLS required except loopback development. Mailpit in compose never sends mail to the internet.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
FLOW_SMTP_ALLOW_PLAINTEXT=false
# YooKassa: blank credentials keep billing disabled. Start with a test shop.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
FLOW_YOOKASSA_WEBHOOK_TOKEN=
FLOW_TEAM_PRICE_CENTS=99000
FLOW_BILLING_ALLOW_LIVE=false
# SQLite only; PostgreSQL backup procedure is documented in docs/DEPLOYMENT.md.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=data/backups
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_TOKEN=
# APP_REVISION=exact-40-character-commit-sha
