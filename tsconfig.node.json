{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "src/task-schema.ts",
    "src/flow-api.ts",
    "src/observability.ts"
  ]
}
